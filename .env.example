# THERMOSENSE Environment Configuration
# Sprint 1 Production & Development Variables

# Server Port and Host
PORT=8000
HOST=127.0.0.1

# JWT Secret Stability Across Restarts
JWT_SECRET=THERMOSENSE_SUPER_SECURE_JWT_SECRET_SPRINT1_PROD

# Database Persistence Path (default: OS temp directory)
THERMOSENSE_DB_PATH=

# Demo Mode Toggle (true: shows 1-click role logins and synthetic banner; false: production mode)
DEMO_MODE=true

# External Weather Integration (Open-Meteo)
WEATHER_CACHE_MINUTES=10
WEATHER_STALE_MINUTES=30
MANUAL_READING_VALID_MINUTES=60

# Frontend Base API URL (for Vite development)
VITE_API_BASE_URL=/api

# Sprint 2 Emergency SOS & Escalation Configuration
SOS_MODE=simulate
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
PUBLIC_BASE_URL=http://localhost:8000
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

